DATABASE_URL=
# Sync driver URL used only by the APScheduler SQLAlchemy job store, e.g.
# postgresql+psycopg2://user:pass@host:5432/dbname
# Without it, jobs live in memory only and are lost on restart.
SYNC_DATABASE_URL=
SECRET_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_APP_PASSWORD=
SUPER_ADMIN_NAME=
API_AUTH_KEY=
MAIL_SERVER=
REDIS_URL=
SENDGRID_API_KEY=
BREVO_API_KEY=
# Optional. Defaults to https://api.brevo.com/v3/smtp/email
BREVO_API_URL=

# --- SMS (Sailup) ------------------------------------------------------------
# Required on the scheduler service, not just the API, or debt reminders and
# scheduled sales reports are disabled and no SMS is ever sent.
# Leave blank in local dev; sends will log a loud error instead of firing.
SAILUP_API_KEY=
# Sender ID registered in the Sailup dashboard. Sailup rejects unregistered
# senders, so a blank value here fails every send.
SAILUP_SENDER_ID=
# Defaults to https://api.sailup.io/v1/sms/
SAILUP_API_URL=
