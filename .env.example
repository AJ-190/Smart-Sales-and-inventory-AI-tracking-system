DATABASE_URL=
SECRET_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_APP_PASSWORD=
SUPER_ADMIN_NAME=
API_AUTH_KEY=
MAIL_SERVER=
REDIS_URL=
SENDGRID_API_KEY=
BREVO_API_KEY=
# Optional. Defaults to https://api.brevo.com/v3/smtp/email
BREVO_API_URL=

# --- SMS (Africa's Talking) -------------------------------------------------
# Required on the worker AND beat services, not just the API, or debt
# reminders are disabled and no SMS is ever sent.
# Leave blank in local dev; reminders will log a loud "DISABLED" error.
SMS_KEY=
# Registered sender ID / short code. Required by the live endpoint.
SMS_SENDER_ID=
# Defaults to the live endpoint. For local testing only, set both of these to
# sandbox values - sandbox messages are accepted but never delivered:
#   SMS_USERNAME=sandbox
#   SMS_API_URL=https://api.sandbox.africastalking.com/version1/messaging
SMS_USERNAME=
SMS_API_URL=